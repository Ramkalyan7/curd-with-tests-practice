generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User{
  id String @id @default(cuid())
  email String @unique
  password String 
  blogs Blog[]
}

model Blog{
  id String @id @default(cuid())
  title String 
  description String
  user_id String
  user User @relation(fields: [user_id] , references: [id],onDelete: Cascade)
}




